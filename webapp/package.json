{
  "name": "lcars-helm",
  "version": "0.1.0",
  "description": "LCARS instrument display for Signal K",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "signalk-webapp",
    "signalk-category-instruments"
  ],
  "signalk": {
    "displayName": "LCARS Helm",
    "appIcon": "./icon.svg"
  },
  "files": [
    "public/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
