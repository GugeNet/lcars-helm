{
  "name": "lcars-helm-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "LCARS-styled Signal K instrument display and boat simulator for sailboats",
  "license": "MIT",
  "workspaces": [
    "simulator",
    "webapp"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sim": "npm run start -w @lcars-helm/simulator",
    "dev:sim": "npm run dev -w @lcars-helm/simulator",
    "dev:web": "npm run dev -w lcars-helm",
    "setup:signalk": "node scripts/setup-dev-signalk.mjs",
    "dev:signalk": "node scripts/setup-dev-signalk.mjs && signalk-server --configdir .signalk-dev"
  },
  "devDependencies": {
    "signalk-server": "^2.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
